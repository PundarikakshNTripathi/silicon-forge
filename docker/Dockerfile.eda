# Production Open-Source EDA Worker Image (Yosys, SymbiYosys, Verilator, OpenROAD, Magic, Netgen, KLayout)
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    yosys verilator iverilog magic netgen-lvs klayout \
    z3 python3 python3-pip git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install LibreLane / OpenLane 2 Python flow infrastructure & Cocotb
RUN pip3 install --no-cache-dir --break-system-packages librelane cocotb

WORKDIR /work
CMD ["bash"]
