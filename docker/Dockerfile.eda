# EDA worker image for formal verification, LEC and lint (Yosys, SymbiYosys, Verilator, Bitwuzla, Z3).
# Place-and-route is NOT included: use LibreLane's own container (`librelane --dockerized`). See docs/eda-setup.md.
FROM ubuntu:24.04

ARG OSS_CAD_RELEASE=2026-11-20
ARG OSS_CAD_FILE=oss-cad-suite-linux-x64-20261120.tgz

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl xz-utils python3 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt && cd /opt \
    && curl -fsSL -o oss.tgz "https://github.com/YosysHQ/oss-cad-suite-build/releases/download/${OSS_CAD_RELEASE}/${OSS_CAD_FILE}" \
    && tar xzf oss.tgz && rm oss.tgz

ENV PATH="/opt/oss-cad-suite/bin:/opt/oss-cad-suite/lib:${PATH}"
WORKDIR /work
CMD ["bash"]
