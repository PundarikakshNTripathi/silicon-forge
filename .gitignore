# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# --- Node / UI ---
node_modules/
services/dashboard/dist/
apps/**/dist/
apps/**/out/
*.tsbuildinfo

# --- C++ ---
services/telemetry_engine/build/
CMakeCache.txt
CMakeFiles/

# --- Run artifacts / EDA outputs ---
runs/
*.vcd
*.fst
*.gds
*.oas
!assets/**/*.gds
!tests/fixtures/*.vcd

# --- Local models & secrets (never commit) ---
models/
*.gguf
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Local agent state (shared harness files ARE committed) ---
.claude/settings.local.json
.claude/projects/
.codex/auth.json

# Playwright / screenshot scratch
.playwright-mcp/
/ui-*.png

# Desktop build outputs
apps/desktop/dist/
apps/desktop/backend-dist/
build/

# per-user runtime state (recent workspaces contain personal paths)
/workspaces.json

# per-workspace state created by the verification tools
.siliconforge/

# bundled into the wheel at build time
services/_resources/

# benchmark datasets are downloaded at run time, never committed
/datasets/
