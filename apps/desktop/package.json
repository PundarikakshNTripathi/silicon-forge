{
  "name": "siliconforge-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "SiliconForge desktop app: autonomous spec-to-GDSII chip design agent",
  "author": "SiliconForge contributors",
  "license": "AGPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.siliconforge.desktop",
    "productName": "SiliconForge",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "build/icon.png", "package.json"],
    "extraResources": [{ "from": "backend-dist", "to": "backend", "filter": ["**/*"] }],
    "asar": true,
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage"], "icon": "build/icon.png", "category": "Development" },
    "mac": { "target": ["dmg"], "category": "public.app-category.developer-tools" },
    "protocols": [{ "name": "SiliconForge", "schemes": ["siliconforge"] }],
    "publish": [{ "provider": "github", "owner": "PundarikakshNTripathi", "repo": "silicon-forge" }]
  }
}
